# Copy this file to ".env" and fill it in. NEVER upload ".env" to GitHub.
SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///./pitsync.db
TIMEZONE=Asia/Kolkata
TOKEN_HOURS=12

# Where your website runs (comma separated). Needed so the browser is allowed to call the API.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Email (leave SMTP_HOST empty to only LOG emails, good for testing)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Password given to the seeded members (they must change it at first login)
SEED_PASSWORD=ChangeMe123!
